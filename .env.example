# App connects as a NON-superuser role: superusers bypass row-level security.
DATABASE_URL=postgres://outreach:outreach@localhost:5432/outreach
# Table owner. Only bin/provision.js uses this, to create tenants.
ADMIN_DATABASE_URL=postgres://hackercode@localhost:5432/outreach

# openssl rand -hex 32
APP_SECRET=
PUBLIC_URL=https://app.youragency.com

# Your own password for the agency panel at /admin (adds clients, sees all
# tenants). Unset means nobody can log in.
ADMIN_PASSWORD=

# Which service sends the mail. Drives the DNS records clients are told to
# publish, so it must match what you actually use: ses | postmark | mailgun |
# smtp (your own server)
MAIL_PROVIDER=ses

# SMTP credentials. SMTP_HOST always wins, so any provider or relay works
# without changing code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Shared secret in the bounce webhook URL. Rotate if exposed.
BOUNCE_WEBHOOK_SECRET=
